# Dependency discovery is intentionally non-fatal at repository scaffold time.
# Platform-specific targets must check CAMERA_CPP_HAS_* and fail with a useful
# message if their required dependency is absent.

find_package(OpenCV QUIET COMPONENTS core imgproc imgcodecs videoio)
if(OpenCV_FOUND)
  set(CAMERA_CPP_HAS_OPENCV ON)
  message(STATUS "OpenCV found: ${OpenCV_VERSION}")
else()
  set(CAMERA_CPP_HAS_OPENCV OFF)
  find_library(CAMERA_CPP_OPENCV_CORE NAMES opencv_core PATHS "C:/opencv/build" "/usr/lib/aarch64-linux-gnu")
  if(CAMERA_CPP_OPENCV_CORE)
    message(STATUS "OpenCV find_package failed, but opencv_core was found at ${CAMERA_CPP_OPENCV_CORE}")
  endif()
  message(WARNING "OpenCV not found. Vision/Pi targets will be unavailable until OpenCV is installed (Windows fallback: install vcpkg packages opencv4[core,imgproc,imgcodecs,videoio] or set OpenCV_DIR).")
endif()

find_package(ZMQ QUIET)
if(NOT ZMQ_FOUND)
  find_library(CAMERA_CPP_ZMQ_LIBRARY NAMES zmq libzmq PATHS "C:/msys64/mingw64/lib" "C:/vcpkg/installed/x64-windows/lib" "/usr/lib/aarch64-linux-gnu")
  find_path(CAMERA_CPP_ZMQ_INCLUDE_DIR NAMES zmq.h PATHS "C:/msys64/mingw64/include" "C:/vcpkg/installed/x64-windows/include" "/usr/include" "/usr/local/include")
  if(CAMERA_CPP_ZMQ_LIBRARY AND CAMERA_CPP_ZMQ_INCLUDE_DIR)
    set(ZMQ_FOUND TRUE)
    set(ZMQ_INCLUDE_DIRS ${CAMERA_CPP_ZMQ_INCLUDE_DIR})
    set(ZMQ_LIBRARIES ${CAMERA_CPP_ZMQ_LIBRARY})
  endif()
endif()
if(ZMQ_FOUND)
  set(CAMERA_CPP_HAS_ZMQ ON)
  message(STATUS "libzmq found")
else()
  set(CAMERA_CPP_HAS_ZMQ OFF)
  message(WARNING "libzmq not found. Pi/laptop messaging targets will be unavailable until libzmq is installed (Windows fallback: vcpkg install libzmq, or set ZMQ_DIR/ZMQ_INCLUDE_DIRS/ZMQ_LIBRARIES).")
endif()
